{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPU Balancer",
  "mainBinaryName": "cpu-balancer",
  "version": "2.0.0",
  "identifier": "com.donak200097.cpubalancer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CPU Balancer",
        "width": 1080,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
